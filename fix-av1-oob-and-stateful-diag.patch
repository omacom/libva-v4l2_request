+/*
+ * DPB slot named by ref_frame_idx[i], or -1 when it is out of range.
+ * VA-API transports ref_frame_idx as uint8_t but the V4L2 control stores it
+ * as __s8: a client value >= 128 turns negative and would pass a plain
+ * "< 8" test, then index reference_frame_ts[] before the array. Reinterpret
+ * the byte as unsigned so every out-of-range value is rejected.
+ */
+static int av1_ref_slot(const struct v4l2_ctrl_av1_frame *frame, unsigned int i)
+{
+	uint8_t slot;
+
+	if (i >= V4L2_AV1_REFS_PER_FRAME)
+		return -1;
+
+	slot = (uint8_t)frame->ref_frame_idx[i];
+	return slot < V4L2_AV1_TOTAL_REFS_PER_FRAME ? (int)slot : -1;
+}
